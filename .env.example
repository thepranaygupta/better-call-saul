# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas free tier M0 for prod; Docker for local dev)
MONGODB_URI=mongodb://localhost:27017/saul

# Auth.js / NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Optional: Azure OpenAI (AI features degrade gracefully when absent) ───────
# The app is fully usable without these — queue, scoring, and analytics all
# function with structured signals only; AI panels show an "AI unavailable" state.

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
# Deployment name
AZURE_OPENAI_DEPLOYMENT=
